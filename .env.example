# Copie este arquivo para .env. Nunca publique o .env ou o banco.
HOST=127.0.0.1
PORT=3101
# Para abrir pela rede: HOST=0.0.0.0 e firewall restrito à rede interna.
# SQLite deve ficar no disco LOCAL de quem executa o Node, não no X:.
# Exemplo no servidor: DATA_DIR=C:/Desenvolvimento/devpool-data
# Sem DATA_DIR, usa a pasta local do perfil do Windows: Devpool/data.
# DATA_DIR=
# Origens extras do frontend, separadas por vírgula e sem barra final.
# CORS_ORIGINS=http://localhost:5500
